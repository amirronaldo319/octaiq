{
  "name": "octaiq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "server": "node --env-file-if-exists=.env server/index.ts",
    "start": "npm run build && npm run server",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "check-keys": "node --env-file-if-exists=.env server/check.ts",
    "fetch-data": "node server/backtest/run.ts --fetch --fetch-only",
    "backtest": "node server/backtest/run.ts",
    "snapshot": "node server/snapshot.ts",
    "ledger": "node server/ledger.ts",
    "refresh": "npm run backtest && npm run ledger && npm run snapshot",
    "market": "node server/market.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "license": "MIT",
  "author": "Amir Keshavarzi"
}
